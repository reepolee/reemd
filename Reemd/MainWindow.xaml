<Window x:Class="Reemd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Reemd - Markdown Editor"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="700"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Vertical divider used between toolbar buttons -->
        <Style x:Key="VerticalSeparator" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="#C0C0C0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: left group (folder + editor actions), right group (project shortcuts) -->
        <Border Grid.Row="0" x:Name="ToolbarBorder"
                Background="#F6F6F6" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                Padding="4,3" TextElement.FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: existing toolbar items -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Folder:" VerticalAlignment="Center" Padding="2,0" />
                    <ComboBox x:Name="FolderCombo" MinWidth="200" IsEditable="True"
                              ToolTip="Path to folder with .md files"
                              LostFocus="FolderCombo_LostFocus"
                              KeyDown="FolderCombo_KeyDown"
                              Text="." />
                    <Button x:Name="BtnBrowse" Content="Browse" Click="Browse_Click" />
                    <Separator Style="{StaticResource VerticalSeparator}" />
                    <Button x:Name="BtnOpenFolder" Content="📂" ToolTip="Open folder in File Explorer" Click="BtnOpenFolder_Click" />
                    <Separator Style="{StaticResource VerticalSeparator}" />
                    <ToggleButton x:Name="BtnToggleTheme" Content="🌙" ToolTip="Toggle dark/light theme" Click="BtnToggleTheme_Click" />
                    <Separator Style="{StaticResource VerticalSeparator}" />
                    <Button x:Name="BtnPull" Content="⬇️ Pull" ToolTip="Pull latest changes from remote (Ctrl+Shift+P)" Click="BtnPull_Click" />
                    <Separator Style="{StaticResource VerticalSeparator}" />
                    <Button x:Name="BtnNewIssue" Content="🐛 New Issue" ToolTip="Create a new GitHub issue (Ctrl+Alt+I)" Click="BtnNewIssue_Click" />
                </StackPanel>

                <!-- Right: project shortcut buttons, justified to the end -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl x:Name="ProjectButtonsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="2,0" Padding="8,2"
                                        ToolTip="{Binding ToolTip}"
                                        Click="ProjectButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Style="{StaticResource VerticalSeparator}" />
                    <Button x:Name="BtnEditProjects" Content="⚙" Padding="6,2" Margin="2,0,2,0"
                            ToolTip="Edit project shortcut buttons"
                            Click="BtnEditProjects_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileListColumn" Width="250" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar with file list -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="FileListHeader" Grid.Row="0" Background="#2D2D2D" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Files" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="FileCountText" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="FileListBox"
                             Margin="0" BorderThickness="0"
                             FontSize="14"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="FileListBox_SelectionChanged"
                             MouseDoubleClick="FileListBox_MouseDoubleClick"
                             PreviewKeyDown="FileListBox_PreviewKeyDown"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}" 
                                               Padding="8,4,4,4"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                            Width="20" Padding="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="PinToggle_Click"
                                            ToolTip="Toggle pin to top">
                                        <TextBlock Text="📌" FontSize="11" />
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0.25" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="SidebarFooter" Grid.Row="2" Background="#E8E8E8" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FileCountStatus" FontSize="12" Foreground="#666" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Grid splitter -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#E0E0E0"
                          ShowsPreview="True" />

            <!-- Right side: split editor + preview -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Editor (left side) - raw markdown text -->
                <Border Grid.Column="0" x:Name="EditorBorder" BorderBrush="#E0E0E0" BorderThickness="1" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Find bar (hidden by default) -->
                        <Border x:Name="FindBar" Grid.Row="0"
                                Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                                Height="34" Visibility="Collapsed">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="FindTextBox" Grid.Column="0"
                                         Height="22" VerticalAlignment="Center"
                                         BorderBrush="#C0C0C0" BorderThickness="1"
                                         Padding="4,0"
                                         TextChanged="FindTextBox_TextChanged"
                                         PreviewKeyDown="FindTextBox_PreviewKeyDown" />

                                <TextBlock x:Name="FindMatchCount" Grid.Column="1"
                                           Text="" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="8,0" MinWidth="40" TextAlignment="Center"
                                           Foreground="#666" />

                                <Button x:Name="FindPrevBtn" Grid.Column="2"
                                        Content="▲" FontSize="11" Width="24" Height="22" Padding="0"
                                        ToolTip="Previous match (Shift+Enter)"
                                        Click="FindPrevBtn_Click" />

                                <Button x:Name="FindNextBtn" Grid.Column="3"
                                        Content="▼" FontSize="11" Width="24" Height="22" Padding="0"
                                        ToolTip="Next match (Enter)"
                                        Click="FindNextBtn_Click" />

                                <Button x:Name="FindCloseBtn" Grid.Column="4"
                                        Content="✕" FontSize="13" Width="24" Height="22" Padding="0"
                                        Margin="8,0,0,0"
                                        ToolTip="Close (Esc)"
                                        Click="FindCloseBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Replace bar (hidden by default, shown on Ctrl+H) -->
                        <Border x:Name="ReplaceBar" Grid.Row="1"
                                Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                                Height="34" Visibility="Collapsed">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ReplaceTextBox" Grid.Column="0"
                                         Height="22" VerticalAlignment="Center"
                                         BorderBrush="#C0C0C0" BorderThickness="1"
                                         Padding="4,0"
                                         PreviewKeyDown="ReplaceTextBox_PreviewKeyDown" />

                                <Button x:Name="ReplaceBtn" Grid.Column="1"
                                        Content="Replace" FontSize="12"
                                        Height="22" MinWidth="60" Padding="6,0"
                                        Margin="8,0,0,0"
                                        ToolTip="Replace current match and find next (Ctrl+Enter)"
                                        Click="ReplaceBtn_Click" />

                                <Button x:Name="ReplaceAllBtn" Grid.Column="2"
                                        Content="All" FontSize="12"
                                        Height="22" MinWidth="34" Padding="6,0"
                                        Margin="4,0,0,0"
                                        ToolTip="Replace all matches"
                                        Click="ReplaceAllBtn_Click" />

                                <Button x:Name="ReplaceCloseBtn" Grid.Column="3"
                                        Content="✕" FontSize="13" Width="24" Height="22" Padding="0"
                                        Margin="8,0,0,0"
                                        ToolTip="Close (Esc)"
                                        Click="ReplaceCloseBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Editor text area -->
                        <Grid Grid.Row="2">
                            <TextBox x:Name="Editor"
                                     Padding="32"
                                     BorderThickness="0"
                                     AcceptsTab="True"
                                     AcceptsReturn="True"
                                     IsUndoEnabled="True"
                                     AllowDrop="True"
                                     FontFamily="Cascadia Code"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextChanged="Editor_TextChanged"
                                     SelectionChanged="Editor_SelectionChanged"
                                     PreviewKeyDown="Editor_PreviewKeyDown"
                                     PreviewDrop="Editor_PreviewDrop"
                                     PreviewDragOver="Editor_PreviewDragOver">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Cut" />
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.Paste" />
                                    <Separator />
                                    <MenuItem Header="Bold (Ctrl+B)" Click="ContextMenu_Bold_Click" />
                                    <MenuItem Header="Italic (Ctrl+I)" Click="ContextMenu_Italic_Click" />
                                    <MenuItem Header="Inline Code (Ctrl+Shift+I)" Click="ContextMenu_InlineCode_Click" />
                                    <MenuItem Header="Code Block (Ctrl+Shift+C)" Click="ContextMenu_CodeBlock_Click" />
                                    <Separator />
                                    <MenuItem Header="Link (Ctrl+K)" Click="ContextMenu_Link_Click" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Grid splitter between editor and preview -->
                <GridSplitter x:Name="EditorPreviewSplitter" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="#E0E0E0"
                              ShowsPreview="True" />

                <!-- Preview (right side) - rendered markdown in WebView2 -->
                <Border Grid.Column="2" x:Name="PreviewBorder" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <wv2:WebView2 x:Name="Preview"
                                      Margin="0"
                                      AllowExternalDrop="False"
                                      DefaultBackgroundColor="White" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar x:Name="AppStatusBar" Grid.Row="2" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="13" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="SavedIndicator" Text="💾 Saved" FontSize="12" Foreground="#2E7D32" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FontSizeText" Text="" FontSize="12" Padding="4,2" />
                    <TextBlock x:Name="PreviewFontSizeText" Text="" FontSize="12" Padding="4,2" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnScrollTop"
                            Content="⤒"
                            FontSize="13"
                            Width="22" Height="20"
                            Padding="0"
                            ToolTip="Scroll to top (Ctrl+Home)"
                            Click="BtnScrollTop_Click" />
                    <Button x:Name="BtnScrollBottom"
                            Content="⤓"
                            FontSize="13"
                            Width="22" Height="20"
                            Padding="0"
                            ToolTip="Scroll to bottom (Ctrl+End)"
                            Click="BtnScrollBottom_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="CursorPositionText" Text="Ln 1, Col 1" FontSize="12" Foreground="#666" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="5">
                <TextBlock x:Name="GitHubStatusText" Text="" FontSize="12" Foreground="#666" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="6">
                <TextBlock x:Name="LastSyncText" Text="" FontSize="12" Foreground="#666" Padding="4,2" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
