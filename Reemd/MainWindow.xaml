<Window x:Class="Reemd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reemd"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Reemd - Markdown Editor"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="700"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" BandIndex="0" Band="0">
            <Label Content="Folder:" VerticalAlignment="Center" Padding="2,0" />
            <ComboBox x:Name="FolderCombo" MinWidth="200" IsEditable="True"
                      ToolTip="Path to folder with .md files"
                      LostFocus="FolderCombo_LostFocus"
                      KeyDown="FolderCombo_KeyDown"
                      Text="." />
            <Button x:Name="BtnBrowse" Content="Browse" Click="Browse_Click" />
            <Separator />
            <Button x:Name="BtnOpenFolder" Content="📂" ToolTip="Open folder in File Explorer" Click="BtnOpenFolder_Click" />
            <Separator />
            <ToggleButton x:Name="BtnToggleTheme" Content="🌙" ToolTip="Toggle dark/light theme" Click="BtnToggleTheme_Click" />
        </ToolBar>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileListColumn" Width="250" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar with file list -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="FileListHeader" Grid.Row="0" Background="#2D2D2D" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Files" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="FileCountText" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="FileListBox"
                             Margin="0" BorderThickness="0"
                             FontSize="14"
                             SelectionChanged="FileListBox_SelectionChanged"
                             MouseDoubleClick="FileListBox_MouseDoubleClick"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Padding="10,4"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="SidebarFooter" Grid.Row="2" Background="#E8E8E8" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FileCountStatus" FontSize="11" Foreground="#666" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Grid splitter -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#E0E0E0"
                          ShowsPreview="True" />

            <!-- Right side: split editor + preview -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Editor (left side) - raw markdown text -->
                <Border Grid.Column="0" x:Name="EditorBorder" BorderBrush="#E0E0E0" BorderThickness="1" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Find bar (hidden by default) -->
                        <Border x:Name="FindBar" Grid.Row="0"
                                Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                                Height="34" Visibility="Collapsed">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="FindTextBox" Grid.Column="0"
                                         Height="22" VerticalAlignment="Center"
                                         BorderBrush="#C0C0C0" BorderThickness="1"
                                         Padding="4,0"
                                         TextChanged="FindTextBox_TextChanged"
                                         PreviewKeyDown="FindTextBox_PreviewKeyDown" />

                                <TextBlock x:Name="FindMatchCount" Grid.Column="1"
                                           Text="" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="8,0" MinWidth="40" TextAlignment="Center"
                                           Foreground="#666" />

                                <Button x:Name="FindPrevBtn" Grid.Column="2"
                                        Content="▲" FontSize="10" Width="24" Height="22" Padding="0"
                                        ToolTip="Previous match (Shift+Enter)"
                                        Click="FindPrevBtn_Click" />

                                <Button x:Name="FindNextBtn" Grid.Column="3"
                                        Content="▼" FontSize="10" Width="24" Height="22" Padding="0"
                                        ToolTip="Next match (Enter)"
                                        Click="FindNextBtn_Click" />

                                <Button x:Name="FindCloseBtn" Grid.Column="4"
                                        Content="✕" FontSize="12" Width="24" Height="22" Padding="0"
                                        Margin="8,0,0,0"
                                        ToolTip="Close (Esc)"
                                        Click="FindCloseBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Replace bar (hidden by default, shown on Ctrl+H) -->
                        <Border x:Name="ReplaceBar" Grid.Row="1"
                                Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                                Height="34" Visibility="Collapsed">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ReplaceTextBox" Grid.Column="0"
                                         Height="22" VerticalAlignment="Center"
                                         BorderBrush="#C0C0C0" BorderThickness="1"
                                         Padding="4,0"
                                         PreviewKeyDown="ReplaceTextBox_PreviewKeyDown" />

                                <Button x:Name="ReplaceBtn" Grid.Column="1"
                                        Content="Replace" FontSize="11"
                                        Height="22" MinWidth="60" Padding="6,0"
                                        Margin="8,0,0,0"
                                        ToolTip="Replace current match and find next (Ctrl+Enter)"
                                        Click="ReplaceBtn_Click" />

                                <Button x:Name="ReplaceAllBtn" Grid.Column="2"
                                        Content="All" FontSize="11"
                                        Height="22" MinWidth="34" Padding="6,0"
                                        Margin="4,0,0,0"
                                        ToolTip="Replace all matches"
                                        Click="ReplaceAllBtn_Click" />

                                <Button x:Name="ReplaceCloseBtn" Grid.Column="3"
                                        Content="✕" FontSize="12" Width="24" Height="22" Padding="0"
                                        Margin="8,0,0,0"
                                        ToolTip="Close (Esc)"
                                        Click="ReplaceCloseBtn_Click" />
                            </Grid>
                        </Border>

                        <!-- Editor text area -->
                        <TextBox x:Name="Editor" Grid.Row="2"
                                 Padding="32"
                                 BorderThickness="0"
                                 AcceptsTab="True"
                                 AcceptsReturn="True"
                                 IsUndoEnabled="True"
                                 AllowDrop="True"
                                 FontFamily="Cascadia Code"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="True"
                                 TextChanged="Editor_TextChanged"
                                 SelectionChanged="Editor_SelectionChanged"
                                 PreviewKeyDown="Editor_PreviewKeyDown"
                                 PreviewMouseWheel="Editor_PreviewMouseWheel" />
                    </Grid>
                </Border>

                <!-- Grid splitter between editor and preview -->
                <GridSplitter x:Name="EditorPreviewSplitter" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="#E0E0E0"
                              ShowsPreview="True" />

                <!-- Preview (right side) - rendered markdown in WebView2 -->
                <Border Grid.Column="2" x:Name="PreviewBorder" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <wv2:WebView2 x:Name="Preview"
                                  Margin="0"
                                  AllowExternalDrop="False"
                                  DefaultBackgroundColor="White" />
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar x:Name="AppStatusBar" Grid.Row="2" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="SavedIndicator" Text="💾 Saved" FontSize="11" Foreground="#2E7D32" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnScrollTop"
                            Content="⤒"
                            FontSize="12"
                            Width="22" Height="20"
                            Padding="0"
                            ToolTip="Scroll to top (Ctrl+Home)"
                            Click="BtnScrollTop_Click" />
                    <Button x:Name="BtnScrollBottom"
                            Content="⤓"
                            FontSize="12"
                            Width="22" Height="20"
                            Padding="0"
                            ToolTip="Scroll to bottom (Ctrl+End)"
                            Click="BtnScrollBottom_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="CursorPositionText" Text="Ln 1, Col 1" FontSize="11" Foreground="#666" Padding="4,2" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="5">
                <TextBlock x:Name="GitHubStatusText" Text="" FontSize="11" Foreground="#666" Padding="4,2" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
