<Window x:Class="Reemd.Dialogs.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Reemd.Dialogs"
        Title="Project Shortcuts"
        Height="520" Width="640"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontSize="14">
    <Window.Resources>
        <local:RowIndexConverter x:Key="RowIndexConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Projects appear as buttons at the end of the toolbar. Click a button (or press its number key 1-9) to open the folder in VSCode and start a terminal in it."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ProjectList" Grid.Column="0"
                     BorderThickness="1"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="ProjectList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ProjectList_PreviewMouseMove"
                     DragOver="ProjectList_DragOver"
                     Drop="ProjectList_Drop"
                     SelectionChanged="ProjectList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource RowIndexConverter}}"
                                       FontWeight="Bold" Foreground="#888" Margin="0,0,10,0" VerticalAlignment="Center"
                                       ToolTip="Button number on the toolbar" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Path}" Foreground="#888" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <Button x:Name="BtnMoveUp" Content="▲" Padding="8,3" Margin="0,0,0,4"
                        ToolTip="Move project up (lower button number)" Click="MoveUp_Click" />
                <Button x:Name="BtnMoveDown" Content="▼" Padding="8,3"
                        ToolTip="Move project down (higher button number)" Click="MoveDown_Click" />
            </StackPanel>
        </Grid>

        <!-- Name + Path + Command editing -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center" Padding="0,0,6,0" />
            <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Padding="3"
                     TextChanged="NameTextBox_TextChanged" />

            <Label Grid.Row="1" Grid.Column="0" Content="Path:" VerticalAlignment="Center" Padding="0,6,6,0" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" Grid.Column="0" Padding="3"
                         AllowDrop="True"
                         TextChanged="PathTextBox_TextChanged"
                         LostFocus="PathTextBox_LostFocus"
                         Drop="PathTextBox_Drop" />
                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="8,2" Click="Browse_Click" />
            </Grid>

            <Label Grid.Row="2" Grid.Column="0" Content="Terminal:" VerticalAlignment="Center" Padding="0,6,6,0" />
            <ComboBox x:Name="TerminalCombo" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                      ToolTip="Terminal used by the default VSCode + terminal launch (ignored when a custom command is set)." />

            <Label Grid.Row="3" Grid.Column="0" Content="Command:" VerticalAlignment="Center" Padding="0,6,6,0" />
            <TextBox x:Name="CommandTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                     ToolTip="Optional custom command. {path} = project folder, {name} = project name. Leave empty for VSCode + terminal." />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="Optional. Runs instead of the default VSCode + terminal launch. {path} = project folder, {name} = project name. Example: code {path} &amp;&amp; wt -d {path}"
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock x:Name="WarningText" Grid.Row="5" Grid.Column="1"
                       Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </Grid>

        <!-- Global hotkey for opening projects from anywhere -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Global hotkey:" VerticalAlignment="Center" Padding="0,0,6,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="HotkeyCombo" MinWidth="160" Padding="3"
                          ToolTip="Modifier keys held while pressing 1-9 to open a project from any app." />
                <TextBlock Text="+ 1..9 opens the project from anywhere"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="#888" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnAdd" Content="Add" Padding="10,3" Margin="0,0,6,0" Click="Add_Click" />
            <Button x:Name="BtnDuplicate" Content="Duplicate" Padding="10,3" Margin="0,0,6,0"
                    ToolTip="Copy the selected project — then just edit the folder" Click="Duplicate_Click" />
            <Button x:Name="BtnUpdate" Content="Update" Padding="10,3" Margin="0,0,6,0" Click="Update_Click" />
            <Button x:Name="BtnRemove" Content="Remove" Padding="10,3" Margin="0,0,18,0" Click="Remove_Click" />
            <Button x:Name="BtnOk" Content="OK" IsDefault="True" Padding="14,3" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>
