<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Reemd.Dialogs.ProjectEditDialog"
        x:CompileBindings="False"
        Title="Project Shortcuts"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        FontSize="14">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Projects appear as buttons at the end of the toolbar. Click a button (or press its number key 1-9) to open the folder in VSCode and start a terminal in it."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ListBox x:Name="ProjectList" Grid.Column="0"
                     BorderThickness="1"
                     SelectionChanged="ProjectList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding Number}"
                                       FontWeight="Bold" Foreground="#888" Margin="0,0,10,0" VerticalAlignment="Center"
                                       ToolTip.Tip="Button number on the toolbar" />
                            <StackPanel>
                                <TextBlock Text="{Binding Project.Name}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Project.Path}" Foreground="#888" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="4">
                <Button x:Name="BtnMoveUp" Content="▲" Padding="8,3"
                        ToolTip.Tip="Move project up (lower button number)" Click="MoveUp_Click" />
                <Button x:Name="BtnMoveDown" Content="▼" Padding="8,3"
                        ToolTip.Tip="Move project down (higher button number)" Click="MoveDown_Click" />
            </StackPanel>
        </Grid>

        <!-- Name + Path + Command editing -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Padding="3"
                     TextChanged="NameTextBox_TextChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" VerticalAlignment="Center" Margin="0,6,6,0" />
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                <TextBox x:Name="PathTextBox" Grid.Column="0" Padding="3"
                         TextChanged="PathTextBox_TextChanged"
                         LostFocus="PathTextBox_LostFocus" />
                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Padding="8,2" Click="Browse_Click" />
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Terminal:" VerticalAlignment="Center" Margin="0,6,6,0" />
            <ComboBox x:Name="TerminalCombo" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                      ToolTip.Tip="Terminal used by the default VSCode + terminal launch (ignored when a custom command is set)." />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Command:" VerticalAlignment="Center" Margin="0,6,6,0" />
            <TextBox x:Name="CommandTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                     ToolTip.Tip="Optional custom command. {path} = project folder, {name} = project name. Leave empty for VSCode + terminal." />
            <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="Optional. Runs instead of the default VSCode + terminal launch. {path} = project folder, {name} = project name. Example: code {path} &amp;&amp; wt -d {path}"
                       Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock x:Name="WarningText" Grid.Row="5" Grid.Column="1"
                       Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       IsVisible="False" />
        </Grid>

        <!-- Global hotkey for opening projects from anywhere -->
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="Global hotkey:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="HotkeyCombo" MinWidth="160" Padding="3"
                          ToolTip.Tip="Modifier keys held while pressing 1-9 to open a project from any app." />
                <TextBlock Text="+ 1..9 opens the project from anywhere"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="#888" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="6">
            <Button x:Name="BtnAdd" Content="Add" Padding="10,3" Click="Add_Click" />
            <Button x:Name="BtnDuplicate" Content="Duplicate" Padding="10,3"
                    ToolTip.Tip="Copy the selected project — then just edit the folder" Click="Duplicate_Click" />
            <Button x:Name="BtnUpdate" Content="Update" Padding="10,3" Click="Update_Click" />
            <Button x:Name="BtnRemove" Content="Remove" Padding="10,3" Margin="0,0,12,0" Click="Remove_Click" />
            <Button x:Name="BtnOk" Content="OK" IsDefault="True" Padding="14,3" Click="Ok_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" IsCancel="True" Padding="10,3" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
